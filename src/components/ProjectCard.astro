---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, tags, cover, coverAlt, year } = project.data;
---

<a
  href={`/work/${project.id}`}
  class="group block no-underline"
  data-astro-prefetch
>
  <div class="overflow-hidden rounded-md bg-subtle">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1280, 1610]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
    />
  </div>

  <div class="mt-4 flex items-baseline justify-between gap-4">
    <h3 class="text-lg font-medium tracking-tight text-fg">
      {title}
    </h3>
    <span class="text-sm tabular-nums text-muted">{year}</span>
  </div>

  <p class="mt-1 text-sm text-muted">{summary}</p>

  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted">
          {tag}
        </li>
      ))}
    </ul>
  )}
</a>
