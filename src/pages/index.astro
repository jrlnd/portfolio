---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatApp from '../components/chat/ChatApp.tsx';
import { profile } from '../content/profile';

const title = `${profile.name} — Ask Me Anything`;
const description = `Chat with an AI assistant briefed on ${profile.name} — a senior full-stack developer based in Toronto. Ask about his projects, skills, and experience.`;
---

<BaseLayout title={title} description={description}>
  <ChatApp client:load name={profile.preferredName ?? profile.name} />
</BaseLayout>
