---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/me.jpg';
---

<BaseLayout title="About — JR Gaoat" description="About JR Gaoat.">
  <section class="mx-auto max-w-3xl px-6 pb-24 pt-16">
    <p class="text-sm uppercase tracking-widest text-muted">About</p>
    <h1 class="mt-3 text-4xl font-medium tracking-tight sm:text-5xl">
      Hello, I'm JR.
    </h1>

    <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-[1fr_2fr]">
      <div class="overflow-hidden rounded-md bg-subtle">
        <Image
          src={portrait}
          alt="Portrait of JR Gaoat"
          widths={[320, 480, 640]}
          sizes="(min-width: 768px) 240px, 50vw"
          class="aspect-4/5 w-full object-cover"
        />
      </div>

      <div class="space-y-4 text-lg leading-relaxed text-fg">
        <p>
          I'm a front-end developer & designer based in
          <span class="text-muted">[your city]</span>. I build product
          interfaces with a designer's eye and ship them with an engineer's
          rigor.
        </p>
        <p class="text-muted">
          Replace this copy with your real bio. Talk about what you're working
          on, what you care about, and how to work with you.
        </p>

        <p class="pt-4">
          <a href="/files/rolando-jr-gaoat-resume.pdf" class="text-fg">
            Download résumé (PDF) ↗
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
