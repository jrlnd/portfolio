---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — JR Gaoat" description="Get in touch.">
  <section class="mx-auto max-w-3xl px-6 pb-24 pt-16">
    <p class="text-sm uppercase tracking-widest text-muted">Contact</p>
    <h1 class="mt-3 text-4xl font-medium tracking-tight sm:text-5xl">
      Let's talk.
    </h1>
    <p class="mt-6 max-w-xl text-xl text-muted">
      The fastest way to reach me is email. I read every message and reply
      within a day or two.
    </p>

    <ul class="mt-12 divide-y divide-border border-y border-border">
      <li class="flex items-baseline justify-between py-5">
        <span class="text-sm uppercase tracking-widest text-muted">Email</span>
        <a href="mailto:hello@example.com" class="text-lg text-fg">
          hello@example.com
        </a>
      </li>
      <li class="flex items-baseline justify-between py-5">
        <span class="text-sm uppercase tracking-widest text-muted">LinkedIn</span>
        <a href="https://www.linkedin.com/" class="text-lg text-fg">
          /in/your-handle
        </a>
      </li>
      <li class="flex items-baseline justify-between py-5">
        <span class="text-sm uppercase tracking-widest text-muted">GitHub</span>
        <a href="https://github.com/" class="text-lg text-fg">
          @your-handle
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
