---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, cover, coverAlt, year, role, liveUrl, repoUrl } =
  project.data;
---

<BaseLayout title={`${title} — JR Gaoat`} description={summary}>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-16">
    <a href="/" class="text-sm text-muted no-underline hover:text-fg">&larr; Back</a>

    <header class="mt-8">
      <p class="text-sm uppercase tracking-widest text-muted">
        {year}{role ? ` · ${role}` : ''}
      </p>
      <h1 class="mt-3 text-4xl font-medium tracking-tight sm:text-5xl">
        {title}
      </h1>
      <p class="mt-4 text-xl text-muted">{summary}</p>

      {tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted">
              {tag}
            </li>
          ))}
        </ul>
      )}

      {(liveUrl || repoUrl) && (
        <div class="mt-6 flex gap-4 text-sm">
          {liveUrl && (
            <a href={liveUrl} class="text-fg" target="_blank" rel="noopener">
              Live ↗
            </a>
          )}
          {repoUrl && (
            <a href={repoUrl} class="text-fg" target="_blank" rel="noopener">
              Source ↗
            </a>
          )}
        </div>
      )}
    </header>

    <div class="mt-10 overflow-hidden rounded-md bg-subtle">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 960, 1280, 1610]}
        sizes="(min-width: 768px) 768px, 100vw"
        class="aspect-[16/10] w-full object-cover"
      />
    </div>

    <div class="prose prose-neutral mt-12 max-w-none text-fg dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
