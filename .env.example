GEMINI_API_KEY=your-key-here
RESEND_API_KEY=your-key-here
# Optional: defaults to "Portfolio <onboarding@resend.dev>" (sandbox sender — only delivers to your verified Resend email).
# Once you've verified a domain in Resend, set this to a sender on that domain.
RESEND_FROM_EMAIL=Portfolio <hello@your-domain.dev>

# Optional: Vercel KV / Upstash Redis credentials for distributed rate-limiting.
# Provisioned automatically by Vercel when you add a KV store to the project.
# If unset (e.g. local dev), API routes fall back to per-instance in-memory
# rate limiting, which is fine for development but resets on each cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=
